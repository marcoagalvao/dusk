# Supabase > Project Settings > API Keys. Use a chave publishable, nunca a secret.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Avisos (opcional). Sem estas variáveis o app funciona e a tela Configurações avisa que eles não estão configurados.
# Gere o par de chaves com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com
# Só no servidor, nunca com prefixo NEXT_PUBLIC_. Supabase > Project Settings > API Keys > secret.
SUPABASE_SERVICE_ROLE_KEY=
# Texto longo e aleatório. A Vercel o envia ao chamar a rota do resumo diário.
CRON_SECRET=
